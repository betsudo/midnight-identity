# Copy to infra/.midnight-indexer.env and replace every value. The private
# file is ignored by Git. Preserve its values while reusing existing volumes.
APP__INFRA__STORAGE__PASSWORD=replace-with-random-password
APP__INFRA__PUB_SUB__PASSWORD=replace-with-random-password
APP__INFRA__LEDGER_STATE_STORAGE__PASSWORD=replace-with-random-password
# Generate 32 random bytes as lowercase hexadecimal, for example with:
# openssl rand -hex 32
APP__INFRA__SECRET=replace-with-64-lowercase-hex-characters
